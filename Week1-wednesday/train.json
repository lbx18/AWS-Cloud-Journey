{
    "version": "2012-10-17",
    "statement": [
        {
            "Sid": "AllowS3ListBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "resource": "arn:aws:s3:::my-lab-bucket"
        },
        {
            "Sid": "AllowS3ReadObjects",
            "Effect": "Allow",
            "Action": ["s3:GetObject", "s3:GetObjectVersion"],
            "resource":"arn:aws:s3:::my-lab-bucket"
        }
    ]
}